<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests the helper's protocol, which is plain C#: runs anywhere, including CI with no NPU.
       Protocol.cs is compiled in directly rather than referencing the packaged exe. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\IdtWindowsAI\Protocol.cs" Link="Protocol.cs" />
    <Compile Include="..\IdtWindowsAI\Server.cs" Link="Server.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- Run by Microsoft.Testing.Platform (the repo's global.json), so no xunit.runner.visualstudio:
         that is the VSTest adapter, which MTP doesn't use and warns about (MTP0001). -->
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
